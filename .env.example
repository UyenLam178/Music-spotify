# --- Cách 1 (mặc định, khuyên dùng khi dev): dùng proxy của Vite ---
# Frontend gọi /api/... và Vite chuyển sang backend bên dưới.
VITE_PROXY_TARGET=http://localhost:8080

# --- Cách 2: gọi thẳng backend (khi deploy, hoặc muốn bỏ proxy) ---
# Cần bật CORS ở SecurityConfig phía Spring Boot.
# VITE_API_BASE_URL=http://localhost:8080/api
